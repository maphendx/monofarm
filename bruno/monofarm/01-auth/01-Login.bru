meta {
  name: Login
  type: http
  seq: 1
}

auth {
  mode: none
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("token", res.body.access_token);
  }
}
