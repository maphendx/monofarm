# Database
DATABASE_URL=postgresql+psycopg://printfarm:printfarm@localhost:5432/printfarm

# Test database (used by pytest; override if needed)
# TEST_DATABASE_URL=postgresql+psycopg://printfarm:printfarm@localhost:5432/printfarm_test

# JWT
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Initial admin (created on first run if no users exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# SimplyPrint
SIMPLYPRINT_API_KEY=
SIMPLYPRINT_ORG_ID=

# Bambu Lab Cloud (optional; Bambu printers won't show without credentials)
# Either email+password OR refresh_token (from Bambu Studio config)
BAMBU_EMAIL=
BAMBU_PASSWORD=
BAMBU_REFRESH_TOKEN=
# Region: us | eu | cn (leave empty for auto-detect from login response)
BAMBU_REGION=

# Telegram
TG_BOT_TOKEN=
TG_REPORT_CHAT_ID=
# Public URL of the printfarm UI — included in Telegram messages
FARM_PUBLIC_URL=http://localhost:3000

# Redis — shared cache for multi-worker deployments (empty = in-process fallback)
REDIS_URL=

# S3-compatible file storage (empty = local disk at data/gcodes/)
# Cloudflare R2 example:
#   S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
#   S3_ACCESS_KEY=<R2 Access Key ID>
#   S3_SECRET_KEY=<R2 Secret Access Key>
#   S3_BUCKET=monofarm-files
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Misc
TIMEZONE=Europe/Kiev
CORS_ORIGINS=http://localhost:3000
